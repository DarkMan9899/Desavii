# Desavii Armenia — apps/web environment variables.
# Copy this file to .env and fill in local/sandbox values.
# See SPRINT_0_IMPLEMENTATION_PLAN.md Chapter 14 and
# FRONTEND_ARCHITECTURE.md Chapter 37.
#
# CRITICAL: every variable here is compiled into publicly-served
# JavaScript (Vite's VITE_ prefix convention). NEVER place a secret,
# API key, or signing secret in this file or in any VITE_-prefixed
# variable — see FRONTEND_ARCHITECTURE.md §34.1 / §37.

VITE_API_BASE_URL=http://localhost:4000/api/v1

# P1.8 (Master Roadmap): VITE_ENVIRONMENT_NAME/VITE_DEFAULT_LOCALE/
# VITE_MONITORING_ENDPOINT/VITE_MAPS_API_KEY were listed here from an
# early planning pass but never actually wired to any code — removed
# rather than left as misleading placeholders. Concretely: the default
# locale is a real hardcoded constant in translations/i18n.js, not
# environment-driven; the map on a listing's detail page
# (modules/listings/.../ListingMap) uses react-leaflet against
# OpenStreetMap tiles, which needs no API key at all; and no frontend
# error-tracking/monitoring integration exists yet (the backend gained
# one in P0.8 — see apps/api/.env.example's ERROR_TRACKING_PROVIDER —
# but nothing analogous exists client-side).

# Phase 20 (SEO) — the canonical production origin (no trailing slash).
# The confirmed production domain is https://desavii.com — production
# builds/deploys MUST set this to that value. Used to build canonical/
# hreflang/OG URLs and the sitemap/robots.txt. Never leave unset in
# production, and never invent a domain here. Local/dev builds fall back
# to http://localhost:5175 when unset (see seoConfig.js).
VITE_PUBLIC_SITE_URL=

# Step A3 (Engagement Analytics — public frontend tracking). A
# collection kill-switch, mirroring the backend's own
# ANALYTICS_COLLECTION_ENABLED (apps/api/.env.example) — production
# collection requires BOTH sides to be intentionally enabled. Default
# false in every environment: legal/consent (A0.1) is still unresolved,
# so no visitor/session identifier is ever created and no
# `POST /analytics/events` call is ever attempted while this is false.
# Never couple this to GA4 — GA4 is a later step (A7) and this tracker
# sends only to Desavii's own first-party endpoint.
VITE_ANALYTICS_COLLECTION_ENABLED=false

# Step A7 (Google Analytics 4 Integration) — fully independent of
# VITE_ANALYTICS_COLLECTION_ENABLED above; enabling one never implies or
# gates the other (see analytics/ga4/ for the independence contract).
# GA4 is considered "configured" only when BOTH of these are set: the flag
# is literally the string "true" AND the measurement ID matches the real
# `G-XXXXXXXXXX` GA4 Web Stream format — a missing/invalid ID is always a
# safe no-op, never a startup error. Even when configured, no gtag.js
# request is ever made until explicit analytics consent is GRANTED via
# the consent adapter (setGa4AnalyticsConsent) — see ga4Consent.js. This
# measurement ID is configuration, not a secret; never paste a real
# production ID into shared chat/docs, but it is safe to commit here as
# an empty default.
VITE_GA4_ENABLED=false
VITE_GA4_MEASUREMENT_ID=
