# Desavii Armenia — apps/api environment variables.
# Copy this file to .env and fill in local/sandbox values.
# See SPRINT_0_IMPLEMENTATION_PLAN.md Chapter 14 and
# BACKEND_ARCHITECTURE.md Chapter 19. No real secret is ever committed —
# this file exists only to enumerate required keys with safe placeholders.
# Every value below also has a working local-dev default in
# src/config/index.js, so a fresh clone can run without a .env at all —
# copying this file is still recommended so you know what's configurable.

NODE_ENV=development
PORT=4000

# Database (MySQL 8.x — DATABASE_ARCHITECTURE.md)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=travelhub_dev
DATABASE_USER=travelhub
DATABASE_PASSWORD=travelhub_dev_only
# Isolated database for `npm run test:integration` — never point this at a
# database with real data; the integration suite migrates/seeds/truncates it.
DATABASE_NAME_TEST=travelhub_test

# Redis (BACKEND_ARCHITECTURE.md §38)
REDIS_URL=redis://localhost:6379

# JWT (BACKEND_ARCHITECTURE.md §12) — generate real secrets per environment;
# never reuse the placeholder below outside local development.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Booking Engine constants (BOOKING_ENGINE_ARCHITECTURE.md §5.2)
RESERVATION_HOLD_DURATION_MINUTES=15
# How long a booking may sit in PENDING_VENDOR before the scheduled sweep
# auto-expires it — separate from the reservation-hold TTL above (that one
# guards checkout; this one guards a vendor's response time on an
# already-created booking).
BOOKING_PENDING_VENDOR_SLA_HOURS=48

# Rate limiting (BACKEND_ARCHITECTURE.md §48 / API_SPECIFICATION.md §17)
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
RATE_LIMIT_PUBLIC_PER_MINUTE=20
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
# Bounded tier for the build-time prerender.mjs pipeline only (Phase 20
# SEO) — never reachable from the public internet even if the token below
# leaks, since it also requires the request to originate from loopback
# (rateLimiter.js's isTrustedInternalBuildRequest).
RATE_LIMIT_INTERNAL_BUILD_PER_MINUTE=1000
# Set this to a locally-generated secret (e.g. `openssl rand -hex 32`) and
# export the SAME value as PRERENDER_INTERNAL_TOKEN before running
# `npm run prerender` in apps/web. Leave empty to keep this tier
# unreachable (the default) — the public tier then governs the crawl,
# same as before this existed.
PRERENDER_INTERNAL_TOKEN=

# CORS (BACKEND_ARCHITECTURE.md §47) — comma-separated allowlist, no wildcard
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend origin a staff-invitation email links back to
WEB_APP_URL=http://localhost:5173

# Encrypts inventory_connections.config (may hold a real iCal/PMS/OTA API
# key) at rest. Generate a real secret per environment (e.g.
# `openssl rand -hex 32`); never reuse the placeholder below outside local
# development. Any string works as input (the app derives a real AES-256
# key from it), but a longer, random value is still what production needs.
CONNECTOR_CONFIG_ENCRYPTION_KEY=dev-only-connector-config-key-change-me

# Object storage (P0.7) — `local` (disk-backed, dev-only) is the default;
# set `s3` to store uploads in real object storage instead. Works against
# real AWS S3 or any S3-compatible provider (Cloudflare R2, DigitalOcean
# Spaces, MinIO) — set STORAGE_S3_ENDPOINT to target one of those, leave
# it empty for real AWS S3.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# MinIO (and some other S3-compatible servers) need path-style addressing.
STORAGE_S3_FORCE_PATH_STYLE=false
# The CDN/custom domain (or the bucket's own public endpoint) that public
# object URLs are built from — required once STORAGE_PROVIDER=s3.
STORAGE_S3_PUBLIC_BASE_URL=

# Email delivery (P0.3) — `console` (a real, observable log line, never a
# silent no-op) is the default; `resend` selects a real provider.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Error tracking / observability (P0.8) — `none` (the structured logger
# only) requires no account; `sentry` selects a real Sentry.io adapter.
ERROR_TRACKING_PROVIDER=none
SENTRY_DSN=

# Payment Infrastructure (Phase 16 / Stripe go-live preflight) — `local`
# (fully simulated, never touches real money — see
# modules/payments/providers/localPaymentProvider.js, and NEVER even
# constructed when NODE_ENV=production) is the default and the only
# provider active until real credentials exist. Selecting `stripe`
# without a secret key is a runtime error in development/test, but a
# refused boot in production. DO NOT put a real live secret key in this
# file or in a shared .env — production secrets belong in your deployment
# platform's secret manager, never committed anywhere.
#
# PAYMENTS_ENABLED is the separate go-live sequencing switch: the
# marketplace can (and by default does, in production) run with online
# payments completely off — no payment action is offered anywhere, on
# either side — independent of which provider is configured. Flipping
# this to true in production additionally requires STRIPE_SECRET_KEY,
# STRIPE_PUBLISHABLE_KEY, and STRIPE_WEBHOOK_SECRET to all be set with
# real values, or the process refuses to start.
PAYMENTS_ENABLED=false
PAYMENT_DEFAULT_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
# The ONLY Stripe value ever safe to expose to the browser — read through
# the public GET /payments/config endpoint. Never confuse with
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET above, which must never leave
# the backend.
STRIPE_PUBLISHABLE_KEY=

# AI Platform (Phase 15) — `local` (a deterministic, keyword/template
# composer grounded in real listing/booking data — see
# modules/ai/providers/localHeuristicProvider.js; genuinely NOT an LLM)
# is the default and the only provider ever exercised until one of the
# real keys below is set. Selecting a non-`local` provider with no
# matching key is a runtime error, never a boot crash.
AI_DEFAULT_PROVIDER=local
AI_CACHE_TTL_SECONDS=3600
AI_MAX_RETRIES=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01
# Only relevant if you're running a local Ollama server — not a hosted
# provider, no API key involved.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Logging
LOG_LEVEL=info

# Engagement Analytics (Step A2) — a collection kill-switch, not a legal
# consent signal. Default false in every environment: POST /analytics/events
# and every server-authoritative event hook (favorite/booking) write nothing
# while this is false, regardless of whether the endpoint itself is deployed.
# Do not set true in production until the legal/consent dependency (A0.1) is
# resolved.
ANALYTICS_COLLECTION_ENABLED=false
