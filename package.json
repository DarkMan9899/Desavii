{
  "name": "desavii",
  "private": true,
  "version": "0.0.0",
  "description": "Desavii Armenia — monorepo root (apps/web, apps/api, packages/*)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:contract": "npm run test:contract --workspaces --if-present",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:migrate:down": "npm run db:migrate:down --workspace apps/api",
    "db:migrate:status": "npm run db:migrate:status --workspace apps/api",
    "db:migrate:test": "npm run db:migrate:test --workspace apps/api",
    "db:migrate:test:down": "npm run db:migrate:test:down --workspace apps/api",
    "db:migrate:test:status": "npm run db:migrate:test:status --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:seed:test": "npm run db:seed:test --workspace apps/api",
    "db:reset": "npm run db:reset --workspace apps/api",
    "db:reset:test": "npm run db:reset:test --workspace apps/api",
    "db:reset:dev": "npm run db:reset:dev --workspace apps/api --",
    "db:seed:demo": "npm run db:seed:demo --workspace apps/api",
    "db:seed:demo:dev": "npm run db:seed:demo:dev --workspace apps/api --",
    "db:seed:qa": "npm run db:seed:qa --workspace apps/api --"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2"
  }
}
